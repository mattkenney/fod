doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport")
    title= feed.title
    meta(content="yes" name="apple-mobile-web-app-capable")
    meta(content="yes" name="mobile-web-app-capable")
    link(href="/favicon.ico" rel="icon" sizes="32x32")
    link(href="/icon/fav.svg" rel="icon" type="image/svg+xml")
    link(href="/icon/180.png" rel="apple-touch-icon")
    link(href="/manifest.json" rel="manifest")
    style !{style}
  body
    h1(id='t')
      span= feed.title
      |
      |
      small(class="datetime")= feed.lastBuildDate
    each item, index in feed.items
      div(id='i' + (index + 1))
        hr
        div
          small= '#' + (index + 1) + '/' + feed.items.length
          a(class="local r" href="#t") ^
        div !{item.description}
    script !{script}
